---
import { stats } from '../../content/copy';
import Ellipses from './Ellipses.astro';
const acc = ['green', 'sky', 'coral', 'amber'];
const CELLS = 22;
---
<section class="stats" id="stats" data-stats>
  <ul class="stats__grid" role="list">
    {stats.map((s, i) => (
      <li class={`st st--${acc[i]}`} data-stat data-n={s.number} data-n2={s.numberTo ?? ''} data-dec={s.decimals}>
        <span class="br br--tl" aria-hidden="true"></span>
        <span class="br br--tr" aria-hidden="true"></span>
        <span class="br br--bl" aria-hidden="true"></span>
        <span class="br br--br" aria-hidden="true"></span>
        <p class={`st__v ${i % 2 ? 'gt--ca' : 'gt--gs'}`}>
          <span class="sr">{s.value}</span>
          <span aria-hidden="true" data-val>{s.value}</span>
        </p>
        <div class="px" aria-hidden="true">
          {Array.from({ length: CELLS }, (_, k) => <span class="px__c" style={k >= CELLS - 4 ? `opacity:${[0.7, 0.48, 0.28, 0.14][k - (CELLS - 4)]}` : undefined}></span>)}
        </div>
        <p class="st__l">{s.label}</p>
        <p class="st__s mono">{s.source}</p>
      </li>
    ))}
  </ul>
  <Ellipses uid="div" class="stats__ell" />
</section>
