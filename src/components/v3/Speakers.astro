---
import { speakers } from '../../content/copy';
---
<section id="speakers" class="sec speakers" data-theme="ink" data-hud="SPEAKERS" data-chapter="speakers" aria-labelledby="speakers-title">
  <div class="speakers__slots wrap" aria-hidden="true">
    {Array.from({ length: 12 }, (_, i) => (
      <div class="slot" style={`--d:${(i * 0.37) % 2.4}s`}>
        <span class="slot__id mono">S.{String(i + 1).padStart(2, '0')}</span>
        <span class="slot__bar"></span>
        <span class="slot__bar slot__bar--s"></span>
        <span class="slot__lbl mono" data-slot-lbl>[ SEALED ]</span>
      </div>
    ))}
  </div>
  <div class="speakers__center">
    <p class="eyebrow mono eyebrow--c"><span class="eyebrow__n" aria-hidden="true">§08</span><span aria-hidden="true">Line-up</span></p>
    <h2 class="h2 speakers__h2" id="speakers-title" data-lines>{speakers.h2}</h2>
    <p class="speakers__body lead" data-fade>{speakers.body}</p>
  </div>
</section>
