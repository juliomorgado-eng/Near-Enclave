---
import { audience, nav } from '../../content/copy';
const label = nav.find((n) => n.id === 'audience')?.label ?? '';
const accents = ['green', 'sky', 'coral', 'amber'];
const n = audience.list.length;
---
<section id="audience" class="sec audience" data-theme="ink" data-hud="THE ROOM" data-chapter="audience" aria-labelledby="audience-title">
  <div class="wrap audience__grid">
    <div class="audience__head">
      <div class="audience__sticky">
        <p class="eyebrow mono"><span class="eyebrow__n" aria-hidden="true">§06</span>{label}</p>
        <h2 class="h2 audience__h2" id="audience-title" data-lines>{audience.h2}</h2>
        <p class="audience__intro lead" data-fade>{audience.body}</p>
        <figure class="audience__fig">
          <img
            data-mosaic
            src="/assets/img/v3/nearcon-C-105-900.webp"
            alt="Printed attendee badges and lanyards laid out on a registration table."
            width="900"
            height="600"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
    <ol class="audience__list">
      {audience.list.map((item, i) => (
        <li class="seat" data-seat style={`--acc: var(--${accents[i % 4]})`} data-cursor="VIEW">
          <span class="seat__idx mono" aria-hidden="true">
            <span class="seat__n">[{String(i + 1).padStart(2, '0')}/{String(n).padStart(2, '0')}]</span>
            <span class="seat__seat">SEAT</span>
          </span>
          <span class="seat__txt">{item}</span>
          <span class="seat__bar" data-seat-bar aria-hidden="true"><span>████ REDACTED ████████ ██ ███</span></span>
          <span class="seat__ul" data-seat-ul aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>
