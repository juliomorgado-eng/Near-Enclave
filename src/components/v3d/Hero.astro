---
import { hero } from '../../content/copy';
import Card from './Card.astro';
---
<section id="top" class="sec hero" data-chapter="hero" data-theme="paper" aria-labelledby="hero-title">
  <div class="hero__stage">
    <!-- the keycard is drawn into this box; clicking it opens the request too -->
    <div class="anchor anchor--hero" data-anchor="hero" data-open-request data-card-hover aria-hidden="true">
      <Card side="front" />
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow mono" data-hero-fade>
      {hero.eyebrowParts.map((p, i) => (
        <>
          {i > 0 && <span class="hero__dot" aria-hidden="true"></span>}
          <span>{p}</span>
        </>
      ))}
    </p>
    <h1 class="hero__title" id="hero-title">
      <span class="hero__kicker" data-hero-line>{hero.h1Lead}</span>
      {' '}
      <span class="hero__main"><span class="hero__ln"><span data-hero-line>{hero.h1Lines[0]}</span></span>{' '}<span class="hero__ln"><span data-hero-line>{hero.h1Lines[1]}</span></span></span>
    </h1>
    <p class="hero__sub" data-hero-fade>{hero.subhead}</p>
    <div class="hero__cta" data-hero-fade>
      <button class="cta cta--lg" type="button" data-open-request data-card-hover>
        <span class="cta__txt">{hero.cta}</span>
        <span class="cta__arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>
