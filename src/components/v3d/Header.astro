---
import NearLogo from '../shared/NearLogo.astro';
import { hero, nav } from '../../content/copy';
const shiftLabel = nav.find((n) => n.id === 'shift')?.label ?? 'The Shift';
---
<header class="hd" data-hd>
  <a class="hd__brand" href="#top" aria-label="NEAR Enclave 2027 — back to top">
    <NearLogo variant="wordmark" class="hd__logo" label="NEAR" />
    <span class="hd__sep" aria-hidden="true"></span>
    <span class="hd__name" aria-hidden="true">Enclave 2027</span>
  </a>
  <nav class="hd__nav" aria-label="Primary">
    <a class="hd__link" href="#shift">{shiftLabel}</a>
  </nav>
  <div class="hd__right">
    <button class="cta cta--sm" type="button" data-open-request>
      <span class="cta__txt">{hero.cta}</span>
      <span class="cta__arrow" aria-hidden="true">→</span>
    </button>
    <button class="hd__menu" type="button" data-menu-open aria-expanded="false" aria-controls="v3d-menu">
      <span class="hd__burger" aria-hidden="true"><i></i><i></i></span><span class="hd__menu-t">Menu</span>
    </button>
  </div>
</header>
