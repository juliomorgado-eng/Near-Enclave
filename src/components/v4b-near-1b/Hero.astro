---
import { heroApply } from '../../content/copy';
// The canvas sets "NEAR Enclave 2027" vertically (Space Grotesk bold) on the flat cube's front face. The h1 keeps
// the full line: the lead is sr-only, the two visible phrases sit outside the frame.
---
<section id="top" class="hero" aria-labelledby="hero-title">
  <canvas class="hero__field" data-hero-field aria-hidden="true"></canvas>
  <div class="wrap hero__grid">
    <p class="hero__eyebrow label" data-hero-in>
      <span class="kick" aria-hidden="true"></span>
      {heroApply.eyebrowParts.map((p, i) => (
        <>
          {i > 0 && <span class="hero__dot" aria-hidden="true">·</span>}
          <span>{p}</span>
        </>
      ))}
    </p>
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="sr-only">{heroApply.h1Lead}</span>
        {' '}
        <span class="hero__ln"><span class="hero__li" data-hero-line>{heroApply.h1Lines[0]}</span></span>
        {' '}
        <span class="hero__ln hero__ln--2"><span class="hero__li" data-hero-line>{heroApply.h1Lines[1]}</span></span>
      </h1>
      <div class="hero__foot">
        <p class="hero__sub" data-hero-in>{heroApply.subhead}</p>
        <div class="hero__cta" data-hero-in>
          <button class="btn btn--lg" type="button" data-open-request>
            <span class="btn__txt">{heroApply.cta}</span>
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
