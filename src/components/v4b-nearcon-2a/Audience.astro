---
import { audience } from '../../content/copy';
const ACC = ['g', 's', 'c', 'a'];
---
<section id="audience" class="sec audience" aria-labelledby="audience-title">
  <div class="wrap audience__grid">
    <div class="audience__head">
      <h2 class="h2 audience__h2" id="audience-title" data-reveal-h2>{audience.h2}</h2>
      <p class="lede audience__p" data-fade>{audience.body}</p>
    </div>
    <ul class="audience__list" role="list">
      {audience.list.map((item, i) => (
        <li class="aud" data-fade>
          <span class="aud__rule" aria-hidden="true" data-rule-x></span>
          <span class={`pxb pxb--${ACC[i % 4]}`} aria-hidden="true"></span>
          <span class="aud__t">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
