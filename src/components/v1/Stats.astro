---
import { stats } from '../../content/copy';
const accents = ['var(--green)', 'var(--sky)', 'var(--coral)', 'var(--amber)'];
---
<section class="section stats theme-light" id="numbers" aria-label="Market context">
  <div class="wrap">
    <div class="stats__head mono" aria-hidden="true" data-reveal>
      <span>Signal / Onchain capital</span>
      <span>{`[${String(stats.length).padStart(2, '0')}]`}</span>
    </div>
    <ul class="stats__grid">
      {stats.map((s, i) => (
        <li class="stat" style={`--accent:${accents[i % 4]}`} data-reveal>
          <span class="stat__mark" aria-hidden="true"></span>
          <p
            class="stat__value"
            data-count
            data-prefix={s.prefix}
            data-number={s.number}
            data-number-to={s.numberTo ?? ''}
            data-decimals={s.decimals}
            data-suffix={s.suffix}
            data-final={s.value}
          >{s.value}</p>
          <p class="stat__label">{s.label}</p>
          <p class="stat__source mono">{s.source}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
