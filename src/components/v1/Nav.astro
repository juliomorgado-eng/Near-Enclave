---
import NearLogo from '../shared/NearLogo.astro';
import Cta from './Cta.astro';
import { nav, hero } from '../../content/copy';
---
<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a class="nav__brand" href="#top" aria-label="NEAR Enclave 2027 — back to top">
      <NearLogo class="nav__logo" label="NEAR" />
      <span class="nav__tag" aria-hidden="true">Enclave</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav__links">
        {nav.map((item) => (
          <li><a href={`#${item.id}`} data-anchor>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <Cta label={hero.cta} size="sm" />
  </div>
</header>
