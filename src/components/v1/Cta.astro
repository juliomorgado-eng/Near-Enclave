---
interface Props {
  label: string;
  variant?: 'gradient' | 'black';
  size?: 'md' | 'sm';
  class?: string;
}
const { label, variant = 'gradient', size = 'md', class: className = '' } = Astro.props;
---
<button
  type="button"
  class:list={['btn', variant === 'black' && 'btn--black', size === 'sm' && 'btn--sm', className]}
  aria-haspopup="dialog"
  data-open-request
>
  <span class="btn__label">{label}</span>
  <span class="btn__arrow" aria-hidden="true">→</span>
</button>
