---
import { heroApply } from '../../content/copy';
---
<header class="hd" data-hd>
  <a class="hd__brand" href="#top" aria-label="NEAR — back to top">
    <img class="hd__logo" src="/v3d-near/near-primary-dark.svg" alt="NEAR" width="212" height="52" />
  </a>
  <button class="cta cta--sm" type="button" data-open-request data-card-hover>
    <span class="cta__txt">{heroApply.cta}</span>
    <span class="cta__arrow" aria-hidden="true">→</span>
  </button>
</header>
