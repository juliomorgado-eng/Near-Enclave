---
import { shift } from '../../content/copy';
---
<section id="shift" class="sec shift" aria-labelledby="shift-title">
  <div class="shift__grid wrap">
    <div class="shift__text">
      <h2 class="h2 shift__h2" id="shift-title" data-lines>{shift.h2}</h2>
      <ul class="shift__list">
        {shift.body.map((s, i) => (
          <>
            {i === 2 && (
              <li class="shift__mcard" aria-hidden="true">
                <div class="anchor anchor--shiftm" data-anchor="shiftm"></div>
              </li>
            )}
            <li class={`shift__s${i === 2 ? ' shift__s--key' : ''}`} data-shift-s>{s}</li>
          </>
        ))}
      </ul>
    </div>
    <div class="shift__side">
      <div class="shift__sticky">
        <div class="anchor anchor--shift" data-anchor="shift" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
