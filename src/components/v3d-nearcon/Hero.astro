---
import { heroApply } from '../../content/copy';
import Seal from './Seal.astro';
---
<section id="top" class="sec hero" aria-labelledby="hero-title">
  <h1 class="hero__title" id="hero-title">
    <span class="hero__lead"><span class="hero__ln"><span data-hero-line>{heroApply.h1Lead}</span></span></span>
    {' '}
    <span class="hero__main">
      <span class="hero__ln hero__ln--1"><span data-hero-line>{heroApply.h1Lines[0]}</span></span>
      {' '}
      <span class="hero__ln hero__ln--2"><span data-hero-line>{heroApply.h1Lines[1]}</span></span>
    </span>
  </h1>
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow mono" data-hero-fade>
        <span class="sr-only">{heroApply.eyebrow}</span>
        {heroApply.eyebrowParts.map((p) => <span class="hero__ep" aria-hidden="true">{p}</span>)}
      </p>
      <p class="hero__sub" data-hero-fade>{heroApply.subhead}</p>
      <div class="hero__act" data-hero-fade>
        <button class="cta cta--lg" type="button" data-open-request data-card-hover>
          <span class="cta__txt">{heroApply.cta}</span>
          <span class="cta__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
    <div class="hero__stage">
      <div class="anchor anchor--hero" data-anchor="hero" data-open-request data-card-hover aria-hidden="true">
        <Seal />
      </div>
    </div>
  </div>
</section>
