---
import { format, formatParagraph } from '../../content/copy';
import Seal from './Seal.astro';
---
<section id="format" class="sec format" aria-labelledby="format-title">
  <div class="format__grid">
    <div class="format__text">
      <h2 class="h2 format__h2" id="format-title" data-lines>{format.h2}</h2>
      <p class="format__p" data-fade>{formatParagraph}</p>
    </div>
    <div class="format__stage">
      <div class="anchor anchor--format" data-anchor="format" aria-hidden="true"><Seal /></div>
      <span class="format__line" aria-hidden="true"></span>
    </div>
  </div>
</section>
