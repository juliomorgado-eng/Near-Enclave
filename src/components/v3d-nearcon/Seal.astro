---
// Static sealed invitation: frosted glass + amber NEAR seal, no printed text.
// Shown when WebGL is unavailable, motion is reduced, or the bundle failed.
import NearLogo from '../shared/NearLogo.astro';
---
<div class="seal" aria-hidden="true">
  <span class="seal__lines"><i></i><i></i><i></i><i></i></span>
  <span class="seal__wax"><NearLogo variant="mark" class="seal__mark" label="NEAR" /></span>
</div>
