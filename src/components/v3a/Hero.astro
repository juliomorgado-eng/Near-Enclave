---
import { hero } from '../../content/copy';
---
<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__in wrap">
    <p class="hero__eyebrow mono" data-hero-fade>
      {hero.eyebrowParts.map((p, i) => (
        <>
          {i > 0 && <span class="hero__sep" aria-hidden="true">/</span>}
          <span>{p}</span>
        </>
      ))}
    </p>
    <h1 class="hero__title" id="hero-title">
      <span class="hero__kicker mono" data-hero-fade>{hero.h1Lead}</span>
      {' '}
      <span class="hero__line"><span class="hero__li" data-hero-line>{hero.h1Lines[0]}</span></span>
      <span class="hero__gap ap-anchor" data-ap="hero" aria-hidden="true"><span class="ap-fallback"></span></span>
      {' '}
      <span class="hero__line"><span class="hero__li" data-hero-line>{hero.h1Lines[1]}</span></span>
    </h1>
    <p class="hero__sub" data-hero-fade>{hero.subhead}</p>
    <div class="hero__cta" data-hero-fade>
      <button class="btn" type="button" data-open-request>
        <span class="btn__txt">{hero.cta}</span>
        <span class="btn__arr" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>
