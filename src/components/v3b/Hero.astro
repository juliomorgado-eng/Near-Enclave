---
import { hero, nav } from '../../content/copy';
const shiftLabel = nav.find((n) => n.id === 'shift')?.label ?? '';
// Static glyph field for the no-WebGL fallback (deterministic, decorative).
const G = '01$#/\\+×≡◇·';
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const rows = Array.from({ length: 40 }, () =>
  Array.from({ length: 120 }, () => (rnd() > 0.62 ? G[(rnd() * G.length) | 0] : ' ')).join(''),
).join('\n');
---
<section id="top" class="sec hero" data-chapter="hero" aria-labelledby="hero-title">
  <div class="hero__fallback" aria-hidden="true"><pre class="hero__ascii">{rows}</pre></div>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow mono" data-hero-fade>
        {hero.eyebrowParts.map((p, i) => (
          <>
            {i > 0 && <span class="hero__dot" aria-hidden="true">·</span>}
            <span>{p}</span>
          </>
        ))}
      </p>
      <h1 class="hero__title" id="hero-title">
        <span class="hero__kicker" data-hero-kicker>{hero.h1Lead}</span>
        {' '}
        <span class="hero__line"><span class="hero__li" data-hero-line>{hero.h1Lines[0]}</span></span>
        {' '}
        <span class="hero__line"><span class="hero__li" data-hero-line>{hero.h1Lines[1]}</span></span>
      </h1>
      <p class="hero__sub" data-hero-fade>{hero.subhead}</p>
      <div class="hero__cta" data-hero-cta>
        <button class="btn btn--lg" type="button" data-open-request>
          <span class="btn__txt">{hero.cta}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
        <a class="hero__next mono" href="#shift">{shiftLabel} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero__stage" aria-hidden="true" data-hero-fade>
      <div class="enclave">
        <div class="enclave__box slab-anchor" data-slab-anchor>
          <div class="enclave__css"></div>
          <span class="enclave__tag enclave__tag--in mono">In · ciphertext</span>
          <span class="enclave__tag enclave__tag--out mono">Out · verified</span>
        </div>
      </div>
    </div>
  </div>
</section>
