---
import { format, formatParagraph } from '../../content/copy';
---
<section id="format" class="sec format" data-chapter="format" aria-labelledby="format-title">
  <div class="format__pin">
    <div class="wrap format__grid">
      <div class="format__stage" aria-hidden="true">
        <div class="enclave">
          <div class="enclave__box slab-anchor" data-slab-anchor><div class="enclave__css"></div></div>
        </div>
      </div>
      <h2 class="h2 format__h2" id="format-title" data-format-h2>{format.h2}</h2>
      <p class="format__p" data-format-p>{formatParagraph}</p>
    </div>
  </div>
</section>
