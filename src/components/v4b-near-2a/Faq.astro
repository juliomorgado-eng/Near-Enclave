---
import { faq, contact } from '../../content/copy';
import Kicker from './Kicker.astro';
---
<section id="faq" class="sec faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <Kicker i={9} />
      <h2 class="h2 faq__h2" id="faq-title" data-split>{faq.h2}</h2>
    </div>
    <div class="faq__list" data-fade>
      {faq.items.map((item, i) => (
        <details class="qa">
          <summary class="qa__q">
            <span class="qa__i label" aria-hidden="true">0{i + 1}</span>
            <span class="qa__t">{item.q}</span>
            <span class="qa__icon" aria-hidden="true"></span>
          </summary>
          <div class="qa__a">
            <p>
              {item.contact ? (
                <Fragment>Press: <a href={`mailto:${contact.press}`}>{contact.press}</a> · Sponsorship: <a href={`mailto:${contact.sponsorship}`}>{contact.sponsorship}</a></Fragment>
              ) : (
                item.a
              )}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
