---
import { audience } from '../../content/copy';
// List on the left (1–7), head on the right (9–12, sticky). Rows split by dot rules.
---
<section id="audience" class="sec audience" aria-labelledby="audience-title">
  <div class="wrap audience__grid">
    <div class="audience__head">
      <h2 class="h2 audience__h2" id="audience-title" data-split>{audience.h2}</h2>
      <p class="body audience__p" data-fade>{audience.body}</p>
    </div>
    <ul class="audience__list" role="list">
      {audience.list.map((item) => (
        <li class="aud" data-fade>
          <span class="aud__px" aria-hidden="true"></span>
          <span class="aud__t">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
