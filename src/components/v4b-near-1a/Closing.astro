---
import { closing, formApply, heroApply } from '../../content/copy';
import { path, bayer, type Mod } from './pixel';
// Apply flow: heading formApply.title, button heroApply.cta, closing.body kept.
// Right cell: flat green with 135° diagonals drawn as module rows (a dotted hatch that
// thickens towards the lower right).
const N = 40;
const mods: Mod[] = [];
for (let y = 0; y < N; y++)
  for (let x = 0; x < N; x++) {
    const diag = (x + y) % 6;
    if (diag > 1) continue;
    const k = (x + y) / (2 * N);
    const s = Math.min(0.9, 0.2 + k * 0.9 + (bayer(x, y) - 0.5) * 0.2);
    mods.push({ x, y, s: diag === 0 ? s : s * 0.5 });
  }
const hatch = path(mods);
---
<section id="request" class="sec closing" aria-labelledby="closing-title">
  <div class="wrap closing__grid">
    <div class="closing__main" data-fade>
      <h2 class="closing__h2" id="closing-title" data-split>{formApply.title}</h2>
      <div class="closing__row">
        <p class="body closing__p">{closing.body}</p>
        <button class="btn btn--lg" type="button" data-open-request>
          <span class="btn__txt">{heroApply.cta}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
    <div class="closing__side" aria-hidden="true" data-fade>
      <svg class="closing__hatch" viewBox={`0 0 ${N} ${N}`} preserveAspectRatio="xMidYMid slice"><path d={hatch} /></svg>
    </div>
  </div>
</section>
