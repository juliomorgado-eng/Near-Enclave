---
import { hero } from '../../content/copy';
import { ledgerRows } from '../../scripts/v3c/ledger';
// Static ledger for the no-WebGL fallback: legible on the public side, redacted on the sealed side.
const rows = ledgerRows(40, 120, 11).map((r) => r.text);
const pub = rows.join('\n');
const seal = rows.map((r) => r.replace(/[^\s→…:]/g, '█')).join('\n');
const [a, b] = hero.h1Lines;
const words = (s: string) => s.split(' ');
---
<section id="top" class="sec hero" data-chapter="hero" aria-labelledby="hero-title">
  <div class="hero__fallback" aria-hidden="true">
    <pre class="hero__fb hero__fb--pub">{pub}</pre>
    <pre class="hero__fb hero__fb--seal">{seal}</pre>
    <span class="hero__fbline"></span>
  </div>
  <div class="hero__inner">
    <p class="hero__eyebrow mono" data-clear data-hero-fade>
      {hero.eyebrowParts.map((p, i) => (
        <>
          {i > 0 && <span class="hero__dot" aria-hidden="true">·</span>}
          <span>{p}</span>
        </>
      ))}
    </p>
    <h1 class="hero__title" id="hero-title">
      <span class="hero__kicker" data-clear data-hero-fade>{hero.h1Lead}</span>
      {' '}
      <span class="hero__half hero__half--pub">
        {words(a).map((w, i) => (
          <>{i > 0 && ' '}<span class="hero__w"><span class="hero__wt" data-hero-pub data-clear>{w}</span></span></>
        ))}
      </span>
      <span class="hero__split" data-split aria-hidden="true">
        <span class="hero__lbl hero__lbl--pub mono" data-hero-fade>Public ledger</span>
        <span class="hero__lbl hero__lbl--seal mono" data-hero-fade>Sealed ledger</span>
      </span>
      {' '}
      <span class="hero__half hero__half--seal">
        {words(b).map((w, i) => (
          <>{i > 0 && ' '}<span class="hero__w"><span class="hero__wt" data-clear>{w}<i class="hero__bar" data-hero-bar aria-hidden="true"></i></span></span></>
        ))}
      </span>
    </h1>
    <div class="hero__foot">
      <p class="hero__sub" data-clear data-hero-fade>{hero.subhead}</p>
      <div class="hero__cta" data-hero-cta>
        <button class="btn btn--lg" type="button" data-open-request data-clear>
          <span class="btn__txt">{hero.cta}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</section>
