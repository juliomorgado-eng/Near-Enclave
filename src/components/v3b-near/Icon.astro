---
// Crisp enclave face icon (SVG). Same 32-unit box as the WebGL mosaic atlas (24-unit icon,
// 4-unit padding). Used as the DOM overlay on the monolith face and as the static fallback.
import { ICONS, STROKE } from '../../scripts/v3b-near/icons';
import nSvg from '../../../public/v3b-near/near-icon-black.svg?raw';
interface Props { i: number; class?: string; [k: string]: unknown }
const { i, class: cls, ...rest } = Astro.props;
const ic = ICONS[i];
const nPath = /d="([^"]+)"/.exec(nSvg)?.[1] ?? '';
---
{ic && (
  <svg class:list={['ico', cls]} viewBox="-4 -4 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width={STROKE} stroke-linecap="square" stroke-linejoin="miter" {...rest}>
    {'fill' in ic && ic.fill ? (
      <path d={nPath} transform={`scale(${24 / 73})`} fill="currentColor" stroke="none" />
    ) : (
      <>
        {'paths' in ic && ic.paths.map((d) => <path d={d} />)}
        {'fills' in ic && (ic.fills ?? []).map((d) => <path d={d} fill="currentColor" stroke="none" />)}
      </>
    )}
  </svg>
)}
