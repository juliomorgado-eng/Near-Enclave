---
// Concentric thin-ellipses mark. Rings trace with the scroll, then colored runners orbit them.
interface Props { class?: string; uid: string }
const { class: cls = '', uid } = Astro.props;
const N = 9;
const rings = Array.from({ length: N }, (_, i) => ({ rx: 180 - i * 19, ry: 46 - i * 4.9, cy: 60 - i * 2.6 }));
const tones = ['green', 'sky', 'coral', 'amber'];
---
<svg class={`ell ${cls}`} viewBox="0 0 400 120" aria-hidden="true" focusable="false" data-ell>
  <defs>
    <linearGradient id={`e-${uid}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#65d56e" /><stop offset="0.34" stop-color="#59c2e8" /><stop offset="0.67" stop-color="#f98372" /><stop offset="1" stop-color="#f1b139" />
    </linearGradient>
  </defs>
  <line x1="0" y1="60" x2="400" y2="60" class="ell__axis" data-axis />
  {rings.map((e, i) => (
    <ellipse cx="200" cy={e.cy} rx={e.rx} ry={e.ry} pathLength="1" data-draw data-cy={e.cy} style={i === 0 ? `stroke:url(#e-${uid})` : undefined} class={i === 0 ? 'ell__out' : undefined} />
  ))}
  <g class="ell__runs">
    {rings.map((e, i) => (
      <ellipse cx="200" cy={e.cy} rx={e.rx} ry={e.ry} pathLength="1" data-run
        class={`ell__run ell__run--${tones[i % 4]}`}
        style={`--d:${(7 + i * 1.3).toFixed(1)}s;--o:${(i * 0.37) % 1};animation-direction:${i % 2 ? 'reverse' : 'normal'}`} />
    ))}
  </g>
  <circle cx="20" cy="60" r="1.8" class="ell__node" data-node />
  <circle cx="380" cy="60" r="1.8" class="ell__node" data-node />
</svg>
