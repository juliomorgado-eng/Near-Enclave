---
// A 3D wire model (city or vault) in a thin circle, with a tick ring that spins, a counter-turning
// dashed inner ring, flowing dashed diagonals and a comet that runs along the drawing.
// The first frame is rendered here (static for no-JS / reduced motion); the client loop redraws it.
import { first } from './geo';

interface Props {
  kind: 'city' | 'vault';
  uid: string;
  mirror?: boolean;
  diag?: boolean;
  class?: string;
}
const { kind, uid, mirror = kind === 'vault', diag = true, class: cls = '' } = Astro.props;
const g = `rg-${uid}`;
const c = `rc-${uid}`;
const fr = first(kind);
const f = (n: number) => Math.round(n * 10) / 10;
const stops = kind === 'city' ? ['#65d56e', '#59c2e8'] : ['#f98372', '#f1b139'];

// tick ring
let ticks = '';
for (let i = 0; i < 120; i++) {
  const a = (i / 120) * Math.PI * 2;
  const long = i % 10 === 0;
  const r0 = long ? 188 : 192, r1 = long ? 199 : 196;
  ticks += `M${f(200 + r0 * Math.cos(a))} ${f(200 + r0 * Math.sin(a))}L${f(200 + r1 * Math.cos(a))} ${f(200 + r1 * Math.sin(a))}`;
}
const rim = [0, 90, 180, 270].map((d) => [200 + 194 * Math.cos((d * Math.PI) / 180), 200 + 194 * Math.sin((d * Math.PI) / 180)]);
const deg = (a: number) => (a * Math.PI) / 180;
const diags = [
  { a: -26, t0: -300, t1: 980, o: 0.5 },
  { a: 64, t0: -120, t1: 420, o: 0.28 },
].map(({ a, t0, t1, o }) => ({
  x1: f(200 + Math.cos(deg(a)) * t0), y1: f(200 + Math.sin(deg(a)) * t0),
  x2: f(200 + Math.cos(deg(a)) * t1), y2: f(200 + Math.sin(deg(a)) * t1), o,
}));
const layers = ['main', 'fine', 'acc'];
---
<svg class={`rig rig--${kind} ${cls}`} viewBox="0 0 400 400" overflow="visible" aria-hidden="true" focusable="false" data-rig={kind}>
  <defs>
    <linearGradient id={g} gradientUnits="userSpaceOnUse" x1="60" y1="360" x2="340" y2="40">
      <stop offset="0" stop-color={stops[0]} />
      <stop offset="1" stop-color={stops[1]} />
    </linearGradient>
    <clipPath id={c}><circle cx="200" cy="200" r="183" /></clipPath>
  </defs>

  {diag && (
    <g class="rig__diag" transform={mirror ? 'matrix(-1 0 0 1 400 0)' : undefined}>
      {diags.map((d) => <line x1={d.x1} y1={d.y1} x2={d.x2} y2={d.y2} stroke-opacity={d.o} data-grow />)}
    </g>
  )}

  <g class="rig__spin" data-spin>
    <path class="rig__ticks" d={ticks} data-fade />
    {rim.map(([x, y]) => <rect class="rig__tick" x={f(x) - 3} y={f(y) - 3} width="6" height="6" data-pop />)}
  </g>
  <circle class="rig__ring" cx="200" cy="200" r="184" pathLength="1" data-draw />
  <g data-spin2><circle class="rig__ring rig__ring--in" cx="200" cy="200" r="172" data-fade /></g>

  <g class="rig__art" clip-path={`url(#${c})`} stroke={`url(#${g})`} fill="none">
    {fr.d.map((d, i) => (
      <path class={`l l--${layers[Math.floor(i / 3)]} b${i % 3}`} d={d} pathLength="1" data-draw data-p={i} />
    ))}
    <path class="rig__pulse" d={fr.pulse} pathLength="1" data-pulse />
    <g class="rig__nodes">
      {fr.nodes.map(([x, y, b]) => <circle class={`nd b${b}`} cx={x} cy={y} r="2.6" data-pop data-n />)}
    </g>
    {fr.blink.map(([x, y], i) => <circle class="blink" cx={x} cy={y} r="3.4" style={`animation-delay:${i * 0.7}s`} fill={`url(#${g})`} stroke="none" data-pop data-b />)}
  </g>
</svg>
