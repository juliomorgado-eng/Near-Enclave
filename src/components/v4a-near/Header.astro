---
import { heroApply } from '../../content/copy';
---
<header class="hd" data-hd>
  <div class="wrap hd__row">
    <a class="hd__logo" href="#top" aria-label="NEAR">
      <img src="/v4a-near/near-primary-light.svg" alt="NEAR" width="212" height="52" />
    </a>
    <button class="cta cta--sm hd__cta" type="button" data-open-request>
      <span>{heroApply.cta}</span><span class="cta__arrow" aria-hidden="true">→</span>
    </button>
  </div>
  <div class="tl tl--progress" aria-hidden="true">
    <span class="tl__on" data-progress></span>
  </div>
</header>
