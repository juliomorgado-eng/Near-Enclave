---
import { heroApply } from '../../content/copy';
---
<header class="hd" data-hd>
  <a class="hd__brand" href="#top" aria-label="NEAR, back to top">
    <img class="hd__logo" src="/v4b-near/near-primary-dark.svg" alt="NEAR" width="212" height="52" />
  </a>
  <button class="btn btn--sm" type="button" data-open-request>
    <span class="btn__txt">{heroApply.cta}</span>
    <span class="btn__arrow" aria-hidden="true">→</span>
  </button>
</header>
