---
import { closing, formApply, heroApply } from '../../content/copy';
// Apply flow: the heading uses formApply.title and the button heroApply.cta; closing.body stays.
const words = formApply.title.split(' ');
const last = words.pop();
---
<section id="request" class="sec closing" aria-labelledby="closing-title">
  <div class="wrap">
    <div class="frame closing__frame" data-fade data-dark>
      <span class="brk" aria-hidden="true"></span>
      <div class="closing__in">
        <h2 class="h2 closing__h2" id="closing-title" data-reveal-h2>{words.join(' ')} <span class="gw gw--ca">{last}</span></h2>
        <div class="closing__row">
          <p class="lede closing__p">{closing.body}</p>
          <button class="cta cta--lg" type="button" data-open-request>
            <span>{heroApply.cta}</span>
            <span class="cta__arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
      <div class="closing__floor" aria-hidden="true">
        <span class="fl fl--g"></span><span class="fl fl--s"></span><span class="fl fl--grad"></span><span class="fl fl--c"></span><span class="fl fl--a"></span><span class="fl fl--cream"></span>
      </div>
    </div>
  </div>
</section>
