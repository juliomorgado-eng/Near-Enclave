---
import { speakers } from '../../content/copy';
// Only the first sentence of speakers.body ("Speakers to be announced."); the second sentence
// carries the old invitation CTA, which the apply flow replaces.
const body = speakers.body.split('. ')[0] + '.';
// Static ASCII portraits (decorative): head-and-shoulders density silhouettes with an encrypted
// band across the eyes. Generated at build time, one variant per card.
const RAMP = ' .:-+=<>/*;01()[]{}';
const SEAL = '{}[]01<>/*;=';
// 48×36 cells at a 0.6 glyph ratio ≈ 4:5, the frame's aspect. X/Y below are in height units.
const C = 48, R = 36;
const portrait = (v: number) => {
  let seed = 97 + v * 131;
  const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
  const cx = 0.4 + (rnd() - 0.5) * 0.04;
  const hrx = 0.13 + rnd() * 0.02, hry = 0.17 + rnd() * 0.02;
  const shw = 0.17 + rnd() * 0.04;
  const lines: string[] = [];
  for (let y = 0; y < R; y++) {
    let s = '';
    for (let x = 0; x < C; x++) {
      const X = (x / C) * 0.8, Y = y / R;
      const head = Math.hypot((X - cx) / hrx, (Y - 0.36) / hry) - 1;
      const neck = Math.abs(X - cx) < 0.055 && Y > 0.48 && Y < 0.7;
      const half = Math.min(0.36, shw + (Y - 0.66) * 1.1);
      const body = Y > 0.66 && Math.abs(X - cx) < half;
      const inside = head < 0 || neck || body;
      const edge = !inside && (Math.abs(head) < 0.12 || (Y > 0.66 && Math.abs(Math.abs(X - cx) - half) < 0.015));
      let ch = ' ';
      if (inside) {
        // light from the upper left
        const l = Math.min(1, Math.max(0, 0.55 + (cx - X) * 2.2 - (Y - 0.3) * 0.4 + (rnd() - 0.5) * 0.12));
        ch = RAMP[Math.max(4, Math.min(RAMP.length - 1, Math.floor(l * RAMP.length)))];
        if (head < 0 && Y > 0.31 && Y < 0.39) ch = SEAL[Math.floor(rnd() * SEAL.length)];
      } else if (edge) ch = ':';
      else if ((x + y * 5) % 13 === 0) ch = '.';
      s += ch;
    }
    lines.push(s);
  }
  return lines.join('\n');
};
const cards = [0, 1, 2, 3].map(portrait);
---
<section id="speakers" class="sec speakers" aria-labelledby="speakers-title">
  <div class="wrap">
    <div class="speakers__head">
      <h2 class="h2 speakers__h2" id="speakers-title" data-reveal-h2>{speakers.h2}</h2>
      <p class="lede speakers__p" data-fade>{body}</p>
    </div>
    <div class="speakers__grid" aria-hidden="true">
      {cards.map((c) => (
        <div class="frame spk" data-fade>
          <span class="brk"></span>
          <pre class="spk__pre">{c}</pre>
        </div>
      ))}
    </div>
  </div>
</section>
