---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/v4a-near.css';

import { metaApply } from '../content/copy';
import Seo from '../components/shared/Seo.astro';
import Header from '../components/v4a-near/Header.astro';
import Hero from '../components/v4a-near/Hero.astro';
import Shift from '../components/v4a-near/Shift.astro';
import Stats from '../components/v4a-near/Stats.astro';
import Format from '../components/v4a-near/Format.astro';
import Footer from '../components/v4a-near/Footer.astro';
import RequestModal from '../components/v4a-near/RequestModal.astro';
---
<!doctype html>
<html lang="en" class="v4an">
  <head>
    <Seo themeColor="#F5F5F5" description={metaApply.description} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('v4an-js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('v4an-motion');
        // Safety net: if the bundle never boots, show the finished drawing.
        setTimeout(function () {
          if (window.__v4anready) return;
          d.classList.remove('v4an-motion');
          d.classList.add('v4an-failsafe');
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <div class="gridlines" aria-hidden="true">
      <div class="wrap grid gridlines__in">
        {Array.from({ length: 12 }, () => <span class="gridlines__c"></span>)}
      </div>
    </div>
    <Header />
    <main id="main">
      <Hero />
      <Shift />
      <Stats />
      <Format />
    </main>
    <Footer />
    <RequestModal />
    <script>
      import '../scripts/v4a-near/main.ts';
    </script>
  </body>
</html>
