---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/v3b-near-2a.css';

import { metaApply } from '../content/copy';
import Seo from '../components/shared/Seo.astro';
import Hud from '../components/v3b-near-2a/Hud.astro';
import Hero from '../components/v3b-near-2a/Hero.astro';
import Shift from '../components/v3b-near-2a/Shift.astro';
import Stats from '../components/v3b-near-2a/Stats.astro';
import LineBand from '../components/v3b-near-2a/LineBand.astro';
import Format from '../components/v3b-near-2a/Format.astro';
import Footer from '../components/v3b-near-2a/Footer.astro';
import RequestModal from '../components/v3b-near-2a/RequestModal.astro';
---
<!doctype html>
<html lang="en" class="v3n2">
  <head>
    <Seo themeColor="#1C1917" description={metaApply.description} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('v3n2-js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('v3n2-motion');
        // Safety net: if the bundle never boots, show every drawing finished.
        setTimeout(function () {
          if (window.__v3n2ready) return;
          d.classList.remove('v3n2-motion');
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <Hud />
    <main id="main">
      <div class="cover">
        <Hero />
        <Shift />
      </div>
      <Stats />
      <LineBand />
      <Format />
    </main>
    <Footer />
    <RequestModal />
    <script>
      import '../scripts/v3b-near-2a/main.ts';
    </script>
  </body>
</html>
