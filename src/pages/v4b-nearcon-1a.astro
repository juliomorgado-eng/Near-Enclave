---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/roboto-mono/400.css';
import '@fontsource/roboto-mono/500.css';
import '../styles/v4b-nearcon-1a.css';

import { metaApply } from '../content/copy';
import Seo from '../components/shared/Seo.astro';
import NearLogo from '../components/shared/NearLogo.astro';
import Header from '../components/v4b-nearcon-1a/Header.astro';
import Hero from '../components/v4b-nearcon-1a/Hero.astro';
import Shift from '../components/v4b-nearcon-1a/Shift.astro';
import Stats from '../components/v4b-nearcon-1a/Stats.astro';
import Format from '../components/v4b-nearcon-1a/Format.astro';
import Agenda from '../components/v4b-nearcon-1a/Agenda.astro';
import Audience from '../components/v4b-nearcon-1a/Audience.astro';
import Partners from '../components/v4b-nearcon-1a/Partners.astro';
import Speakers from '../components/v4b-nearcon-1a/Speakers.astro';
import Closing from '../components/v4b-nearcon-1a/Closing.astro';
import Faq from '../components/v4b-nearcon-1a/Faq.astro';
import Footer from '../components/v4b-nearcon-1a/Footer.astro';
import RequestModal from '../components/v4b-nearcon-1a/RequestModal.astro';
---
<!doctype html>
<html lang="en" class="m4">
  <head>
    <Seo themeColor="#000000" description={metaApply.description} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('m4-js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('m4-motion');
        // Safety net: if the bundle never boots, reveal everything and drop the loader.
        setTimeout(function () {
          if (window.__m4ready) return;
          d.classList.remove('m4-motion');
          d.classList.add('m4-failsafe');
          var l = document.querySelector('[data-loader]');
          if (l) l.remove();
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <div class="ld" data-loader aria-hidden="true">
      <div class="ld__c">
        <NearLogo variant="wordmark" class="ld__logo" label="NEAR" />
        <span class="ld__ramp mono" data-ld-ramp></span>
        <span class="ld__bar" data-ld-bar></span>
      </div>
    </div>
    <script is:inline>
      (function () {
        var l = document.querySelector('[data-loader]');
        if (!document.documentElement.classList.contains('m4-motion') && l) l.remove();
      })();
    </script>
    <Header />
    <main id="main">
      <Hero />
      <Shift />
      <Stats />
      <Format />
      <Agenda />
      <Audience />
      <Partners />
      <Speakers />
      <Closing />
      <Faq />
    </main>
    <Footer />
    <RequestModal />
    <script>
      import '../scripts/v4b-nearcon-1a/main.ts';
    </script>
  </body>
</html>
