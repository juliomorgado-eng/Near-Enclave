---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/v4b-near.css';

import { metaApply } from '../content/copy';
import Seo from '../components/shared/Seo.astro';
import Header from '../components/v4b-near/Header.astro';
import Hero from '../components/v4b-near/Hero.astro';
import Shift from '../components/v4b-near/Shift.astro';
import Stats from '../components/v4b-near/Stats.astro';
import Format from '../components/v4b-near/Format.astro';
import Stripes from '../components/v4b-near/Stripes.astro';
import Footer from '../components/v4b-near/Footer.astro';
import RequestModal from '../components/v4b-near/RequestModal.astro';
---
<!doctype html>
<html lang="en" class="v4bn">
  <head>
    <Seo themeColor="#1C1917" description={metaApply.description} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('v4bn-js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('v4bn-motion');
        // Safety net: if the bundle never boots, show the static page.
        setTimeout(function () {
          if (window.__v4bnready) return;
          d.classList.remove('v4bn-motion');
          d.classList.add('v4bn-failsafe');
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main id="main">
      <Hero />
      <Shift />
      <Stripes seed={3} />
      <Stats />
      <Stripes seed={11} />
      <Format />
    </main>
    <Footer />
    <RequestModal />
    <script>
      import '../scripts/v4b-near/main.ts';
    </script>
  </body>
</html>
