---
import Seo from '../components/shared/Seo.astro';
import NearLogo from '../components/shared/NearLogo.astro';
import { hero } from '../content/copy';

// Shortlist: current options. Variants of the same base share a letter (A1, A2).
const options = [
  {
    id: 'A',
    note: 'NEARCON · negra · ASCII · barras pixel',
    items: [
      { id: 'A1', href: '/v4b-nearcon-1a', note: 'hero izquierda · moneda ASCII · página completa', from: 'v4B · NEARCON 1A' },
      { id: 'A2', href: '/v4b-nearcon-1b', note: 'hero animado · titular en 4 · ASCII divisor con scroll', from: 'v4B · NEARCON 1B' },
      { id: 'A3', href: '/v4b-nearcon-2a', note: 'título grande · ASCII protagonista con scroll · secciones claras · footer nuevo', from: 'base A2', isNew: true },
      { id: 'A4', href: '/v4b-nearcon-2b', note: 'hero y entrada de A2 · título más grande · ASCII grande con scroll · resto de A3', from: 'base A3', isNew: true },
    ],
  },
  {
    id: 'B',
    note: 'near.org · oscura · módulos verdes',
    items: [
      { id: 'B1', href: '/v4b-near-1a', note: 'cubo grande · NEAR Enclave 2027 vertical · ciudad pixel', from: 'v4B · near 1A' },
      { id: 'B2', href: '/v4b-near-2a', note: 'gráficos de puntos estilo Launch Film · PP Neue Montreal · footer nuevo', from: 'base B1', isNew: true },
    ],
  },
  {
    id: 'C',
    note: 'NEARCON · líneas que se trazan · panel cream',
    items: [
      { id: 'C1', href: '/v4a-nearcon-1a', note: 'bóveda y ciudad girando · panel cream sube', from: 'v4A · NEARCON 1A' },
      { id: 'C2', href: '/v4a-nearcon-2a', note: 'giro más calmo · título vivo · gráfica de mercados animada · footer nuevo', from: 'base C1', isNew: true },
    ],
  },
  {
    id: 'D',
    note: 'near.org · enclave / monolito',
    items: [
      { id: 'D1', href: '/v3b-near', note: 'oscura · monolito de vidrio 3D con íconos · + Format', from: 'v3B · near' },
      { id: 'D2', href: '/v3b-near-2a', note: 'flat · solo líneas · oscuro y claro alternado', from: 'base D1', isNew: true },
    ],
  },
];

// Everything else, kept reachable but out of the way.
const archived = [
  { id: 'v1', href: '/v1', note: 'NEARCON brand · premium editorial' },
  { id: 'v2', href: '/v2', note: 'near.org system · NEARCON personality' },
  { id: 'v3', href: '/v3', note: 'Awwwards concept · SEALED · WebGL' },
  { id: 'v3A', href: '/v3a', note: 'Aperture · v1 brand × v3' },
  { id: 'v3B', href: '/v3b', note: 'Enclave · monolito de vidrio' },
  { id: 'v3B · NEARCON', href: '/v3b-nearcon', note: 'NEARCON · clara · copy tal cual · + Format' },
  { id: 'v3C', href: '/v3c', note: 'Two Ledgers · público vs privado' },
  { id: 'v3D', href: '/v3d', note: 'Invitation · keycard' },
  { id: 'v3D · near', href: '/v3d-near', note: 'near.org · oscura · invitación sellada · + Format' },
  { id: 'v3D · NEARCON', href: '/v3d-nearcon', note: 'NEARCON · cream · layout editorial · + Format' },
  { id: 'v4A · near', href: '/v4a-near', note: 'near.org · clara · grilla modular · diagrama de nodos' },
  { id: 'v4A · NEARCON', href: '/v4a-nearcon', note: 'NEARCON · negra · ilustración en círculos · ríos de dígitos' },
  { id: 'v4B · near', href: '/v4b-near', note: 'near.org · oscura · halftone de módulos verdes' },
  { id: 'v4B · near 1B', href: '/v4b-near-1b', note: 'flat · sin pixeles · dots finos · página completa' },
  { id: 'v4B · NEARCON', href: '/v4b-nearcon', note: 'NEARCON · negra · campo ASCII 3D · barras pixel' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <Seo />
    <meta name="robots" content="noindex" />
    <style is:global>
      :root { --cream: #ebe3d3; --ink: #000; --line: #222; --muted: rgb(235 227 211 / .6); --accent: #00dc8d; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100svh; background: var(--ink); color: var(--cream);
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        padding: clamp(24px, 6vw, 72px) 16px;
      }
      main { width: min(960px, 100%); margin-inline: auto; display: grid; gap: 40px; }
      .logo svg { width: 96px; height: auto; }
      h1 { font-size: clamp(28px, 5vw, 56px); line-height: 1.05; letter-spacing: -0.02em; }
      .kicker { font-family: ui-monospace, monospace; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      ul { list-style: none; }
      .tree { display: grid; gap: 2px; background: var(--line); border: 1px solid var(--line); }
      .tree > li { background: var(--ink); }
      a {
        display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px;
        padding: 20px 24px; color: inherit; text-decoration: none; transition: background .2s;
      }
      .group { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; padding: 20px 24px; }
      .group strong { font-size: clamp(24px, 3vw, 34px); min-width: 4ch; }
      .subs .group { padding-block: 14px; }
      .subs .group strong { font-size: clamp(18px, 2.2vw, 24px); }
      .group span { font-size: 15px; color: var(--muted); }
      a:hover, a:focus-visible { background: #111; }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
      a strong { font-size: clamp(24px, 3vw, 34px); min-width: 4ch; }
      a span { font-size: 15px; color: var(--muted); }
      .subs { border-left: 1px solid #333; margin-left: 32px; }
      .subs a { padding-block: 14px; }
      .subs a strong { font-size: clamp(18px, 2.2vw, 24px); }
      a small, .archive summary span { font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: rgb(235 227 211 / .4); }
      a small { margin-left: auto; }
      .new { font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); background: var(--accent); padding: 2px 6px; font-style: normal; }
      .archive summary {
        cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: 12px;
        font-family: ui-monospace, monospace; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
      }
      .archive summary::-webkit-details-marker { display: none; }
      .archive summary::before { content: '+'; color: var(--accent); }
      .archive[open] summary::before { content: '−'; }
      .archive[open] summary { margin-bottom: 16px; }
      .archive a strong { font-size: 18px; min-width: 9ch; }
      @media (max-width: 600px) {
        .subs { margin-left: 16px; }
        a { padding: 16px; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="logo"><NearLogo /></div>
      <h1>{hero.h1}</h1>
      <p class="kicker">Opciones de diseño</p>
      <ul class="tree">
        {options.map((o) => (
          <li>
            {o.href ? (
              <a href={o.href}><strong>{o.id}</strong><span>{o.note}</span><small>{o.from}</small></a>
            ) : (
              <>
                <div class="group"><strong>{o.id}</strong><span>{o.note}</span></div>
                <ul class="subs">
                  {o.items.map((i) => (
                    <li><a href={i.href}><strong>{i.id}</strong><span>{i.note}</span>{i.isNew && <em class="new">nuevo</em>}<small>{i.from}</small></a></li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ul>
      <details class="archive">
        <summary>Archivados <span>{archived.length}</span></summary>
        <ul class="tree">
          {archived.map((a) => (
            <li><a href={a.href}><strong>{a.id}</strong><span>{a.note}</span></a></li>
          ))}
        </ul>
      </details>
    </main>
  </body>
</html>
