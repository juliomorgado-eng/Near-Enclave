---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/roboto-mono/400.css';
import '@fontsource/roboto-mono/500.css';
import '../styles/v3b-nearcon.css';

import { metaApply } from '../content/copy';
import Seo from '../components/shared/Seo.astro';
import NearLogo from '../components/shared/NearLogo.astro';
import Header from '../components/v3b-nearcon/Header.astro';
import Hero from '../components/v3b-nearcon/Hero.astro';
import Shift from '../components/v3b-nearcon/Shift.astro';
import Stats from '../components/v3b-nearcon/Stats.astro';
import Format from '../components/v3b-nearcon/Format.astro';
import Footer from '../components/v3b-nearcon/Footer.astro';
import RequestModal from '../components/v3b-nearcon/RequestModal.astro';
---
<!doctype html>
<html lang="en" class="vnc">
  <head>
    <Seo themeColor="#ebe3d3" description={metaApply.description} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('vnc-js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('vnc-motion');
        // Safety net: if the bundle never boots, reveal everything and drop the loader.
        setTimeout(function () {
          if (window.__vncready) return;
          d.classList.remove('vnc-motion');
          d.classList.add('vnc-failsafe');
          var l = document.querySelector('[data-loader]');
          if (l) l.remove();
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <div class="ld" data-loader aria-hidden="true">
      <div class="ld__center">
        <NearLogo variant="wordmark" class="ld__logo" label="NEAR" />
        <span class="ld__rule" data-ld-rule></span>
      </div>
    </div>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var l = document.querySelector('[data-loader]');
        if (!d.classList.contains('vnc-motion')) { if (l) l.remove(); return; }
        var repeat = false;
        try { repeat = sessionStorage.getItem('vnc-intro') === '1'; } catch (e) {}
        d.classList.add(repeat ? 'vnc-intro-short' : 'vnc-intro-long');
      })();
    </script>
    <canvas class="gl" data-gl aria-hidden="true"></canvas>
    <Header />
    <main id="main">
      <Hero />
      <Shift />
      <Stats />
      <Format />
    </main>
    <Footer />
    <RequestModal />
    <script>
      import '../scripts/v3b-nearcon/main.ts';
    </script>
  </body>
</html>
