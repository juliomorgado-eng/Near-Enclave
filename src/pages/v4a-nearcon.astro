---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/roboto-mono/400.css';
import '@fontsource/roboto-mono/500.css';
import '../styles/v4a-nearcon.css';

import { metaApply } from '../content/copy';
import Seo from '../components/shared/Seo.astro';
import Header from '../components/v4a-nearcon/Header.astro';
import Hero from '../components/v4a-nearcon/Hero.astro';
import Shift from '../components/v4a-nearcon/Shift.astro';
import Stats from '../components/v4a-nearcon/Stats.astro';
import Format from '../components/v4a-nearcon/Format.astro';
import Footer from '../components/v4a-nearcon/Footer.astro';
import Ellipses from '../components/v4a-nearcon/Ellipses.astro';
import RequestModal from '../components/v4a-nearcon/RequestModal.astro';
---
<!doctype html>
<html lang="en" class="pl">
  <head>
    <Seo themeColor="#000000" description={metaApply.description} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('pl-js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('pl-motion');
        // Safety net: if the bundle never boots, show the finished drawing and drop the loader.
        setTimeout(function () {
          if (window.__plready) return;
          d.classList.remove('pl-motion');
          var l = document.querySelector('[data-loader]');
          if (l) l.remove();
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <div class="ld" data-loader aria-hidden="true">
      <Ellipses uid="ld" class="ld__ell" />
    </div>
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains('pl-motion')) {
          var l = document.querySelector('[data-loader]');
          if (l) l.remove();
        }
      })();
    </script>
    <Header />
    <main id="main">
      <Hero />
      <Shift />
      <Stats />
      <Format />
    </main>
    <Footer />
    <RequestModal />
    <script>
      import '../scripts/v4a-nearcon/main.ts';
    </script>
  </body>
</html>
